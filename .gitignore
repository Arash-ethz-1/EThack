# secrets - never commit
.env
secrets.toml

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# generated by `python run.py score` - everyone regenerates it, so nobody commits it
scores/*
!scores/.gitkeep

# editors / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# personal Claude Code settings (the shared ones in .claude/settings.json ARE committed)
.claude/settings.local.json

# raw downloads ARE committed (so nobody downloads twice) - unless a file is > 20 MB.
# Add big raw files here by name, and keep the script that downloads them.

# SEC submissions JSON cache: ~83 MB for 503 companies, only used to derive the small
# social/raw/aliases.csv, which IS committed. Rebuild: python social/scripts/_aliases.py
social/raw/submissions/

# SEC XBRL frames cache: 43 MB across 264 files, only used to derive the 3.9 MB
# social/raw/financials.csv, which IS committed. Rebuild (~7 min):
# python social/scripts/_financials.py
social/raw/frames/

# SEC XBRL companyfacts cache: ~1.8 GB for 503 companies, only used to derive the small
# economic/indicators/*.csv, which IS committed. Rebuild: python run.py build economic <id>
economic/raw/companyfacts_*.json
# FEC bulk transaction files: ~12 zips, hundreds of MB, only used to derive the small
# social/raw/fec_pac_disbursements.csv, which IS committed. Rebuild:
# python social/scripts/_fec_bulk.py
social/raw/fec_bulk/

# SEC 10-K primary documents: 501 filings, ~1-2 GB of HTML, only used to derive the small
# social/indicators/human_capital_disclosure.csv, which IS committed. Rebuild (~25 min):
# python run.py build social human_capital_disclosure
social/raw/tenk/

# FEC transaction detail: 46 MB of itemized PAC transactions, over the 20 MB the repo
# commits. Everything the indicator uses is rolled up into the small
# social/raw/fec_pac_disbursements.csv, which IS committed. Rebuild (~2 min from the
# cached zips): python social/scripts/_fec_bulk.py --parse-only
social/raw/fec_pac_transactions.csv

# FEC API JSON cache: 38 MB, superseded by the bulk route (social/scripts/_fec_bulk.py).
# Kept on disk for provenance; the committed roll-up is social/raw/fec_pac_disbursements.csv
social/raw/fec/
