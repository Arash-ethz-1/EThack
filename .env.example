# `python run.py setup` copies this to .env. .env is never committed.
# If you ever paste a real API key here and commit it by accident: tell Arash, the key must be rotated.

# SEC blocks requests without a contact email in the User-Agent. Any real address works.
SEC_CONTACT_EMAIL=your.name@example.com

# Only needed for the agent checks (checks/agent_*.py, e.g. `python run.py verify
# agent_quote_verify`). Without it those checks are skipped - everything else works fine.
ANTHROPIC_API_KEY=
