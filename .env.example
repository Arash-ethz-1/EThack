# Copy this file to .env and fill in what you need.
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env
#
# .env is gitignored. NEVER commit real keys. If you leak one, rotate it
# immediately - do not just delete the commit, the value is already public.

# --- Required only for the agent layers -------------------------------------
# Jean:    report extraction agent  (src/ethack/sources/reports.py)
# Harprit: red-team agent           (src/ethack/eval/redteam.py)
# Everyone else can leave this blank - nothing else in the pipeline needs it.
ANTHROPIC_API_KEY=

# --- Required for SEC endpoints ---------------------------------------------
# SEC returns 403 without a contact email in the User-Agent header. Any real
# address works. This is a politeness requirement, not a secret.
SEC_CONTACT_EMAIL=your.name@example.com

# --- Optional ----------------------------------------------------------------
# Cap agent spend while developing: how many companies the extraction agent
# processes per run. Raise it once you trust the output.
AGENT_MAX_COMPANIES=10

# Set to 1 to force the dashboard onto mock data even when real output exists.
FORCE_MOCK=0
